{
    "name": "apeir-control-center",
    "version": "0.1.0-rc1",
    "private": true,
    "type": "module",
    "description": "APEIR Control Center desktop application",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build --bundles nsis",
        "tauri:build:x64": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
        "tauri:build:arm64": "tauri build --bundles nsis --target aarch64-pc-windows-msvc",
        "tauri:icon": "tauri icon src-tauri/app-icon.svg",
        "lint": "eslint src --max-warnings=0",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tauri-apps/api": "2.11.1",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "recharts": "^2.10.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tauri-apps/cli": "2.11.4",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "@vitejs/plugin-react": "5.2.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "30.0.1",
        "typescript": "^5.3.0",
        "vite": "7.3.6",
        "vitest": "4.1.11"
    }
}
