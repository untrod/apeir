# Nous Brain Configuration
# cp .env.example .env && chmod 600 .env && edit .env with real values
# .env is NEVER committed to git (in .gitignore)

# ── REQUIRED ──────────────────────────────
# LLM API Key (at least one provider required)
export NOUS_LLM_API_KEY="sk-your-key-here"

# Admin token (used for dashboard, setup, API auth)
export NOUS_AUTH_TOKEN="YOUR_STRONG_RANDOM_AUTH_TOKEN"

# ── SECURITY (DO NOT SKIP) ───────────────
# Brain↔Agent command signing secret
export NOUS_AGENT_SIGNING_SECRET="YOUR_STRONG_RANDOM_SIGNING_SECRET"

# IP whitelist (comma-separated, empty = all WG peers)
export NOUS_ALLOWED_IPS=""

# ── OPTIONAL ──────────────────────────────
# Model pricing for cost tracking (JSON per 1M tokens)
export NOUS_MODEL_PRICING_JSON='{"deepseek-chat":{"input":0,"output":0}}'

# Embedding / RAG
export NOUS_EMBED_MODEL="BAAI/bge-small-zh-v1.5"
export NOUS_VECTOR_DIR="./vector_data"

# ── DEMO MODE ─────────────────────────────
# Run without any API keys or real devices:
#   export NOUS_DEMO_MODE=1
#   python brain.py
# Then open http://localhost:8770/control?token=demo

# ── DEFAULT: SAFE ─────────────────────────
# All HIGH-risk capabilities are DISABLED by default.
# Enable explicitly when you're ready:
# export NOUS_ENABLE_PC_SHELL=1
# export NOUS_ENABLE_PHONE_CONTROL=1
# export NOUS_ENABLE_FILE_WRITE=1
