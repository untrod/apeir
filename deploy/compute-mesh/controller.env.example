# Copy to /etc/apeir-controller/controller.env and restrict it to root:apeir 0640.
APEIR_CONTROLLER_STATE_DIR=/var/lib/apeir-controller
APEIR_CONTROLLER_HOST=0.0.0.0
APEIR_CONTROLLER_PORT=9771
APEIR_CONTROLLER_HEARTBEAT_SECONDS=15
APEIR_CONTROLLER_CERT_FILE=/etc/apeir-controller/tls/fullchain.pem
APEIR_CONTROLLER_KEY_FILE=/etc/apeir-controller/tls/privkey.pem
