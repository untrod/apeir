# APEIR environment template. NOUS_* names remain compatibility identifiers.

export NOUS_BRAIN_HOST="0.0.0.0"
export NOUS_BRAIN_PORT="8770"
export NOUS_LLM_API_KEY="replace-with-provider-key"
export NOUS_AUTH_TOKEN="example-auth-token"
export NOUS_AGENT_SIGNING_SECRET="example-agent-signing-secret"

# Optional provider settings.
export NOUS_LLM_API_URL="https://api.example.com/v1/chat/completions"
export NOUS_LLM_MODEL="example-model"

# Keep high-risk capabilities disabled unless explicitly needed.
# export NOUS_ENABLE_PC_SHELL=1
# export NOUS_ENABLE_PHONE_CONTROL=1
# export NOUS_ENABLE_FILE_WRITE=1

# Provider-neutral cost controls.
export APEIR_MAX_INPUT_TOKENS="65536"
export APEIR_MAX_OUTPUT_TOKENS="4096"
export APEIR_MAX_REQUEST_TOKENS="69632"
export APEIR_MAX_DAILY_TOKENS="1000000"
export APEIR_MAX_DAILY_COST_USD="5.00"
export APEIR_MAX_MODEL_ATTEMPTS="3"
export APEIR_MAX_RETRY_TOKENS="32768"
export APEIR_MAX_RETRY_COST_USD="1.00"
# export APEIR_MODEL_PRICING_FILE="C:\\path\\to\\model-pricing.json"
